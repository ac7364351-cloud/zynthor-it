# Zynthor IT Backend Environment Configuration Example
PORT=8000
NODE_ENV=production

# Database Connection (Option 1: Single Connection String URL - Recommended for Cloud Providers)
# DATABASE_URL=mysql://username:password@gateway.example.com:4000/zynthor_it

# Database Connection (Option 2: Discrete Connection Variables)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=zynthor_it

# SSL Configuration (Set to true for cloud-hosted databases)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Frontend URL (optional, for CORS restriction if needed)
# FRONTEND_URL=https://zynthor-it.vercel.app
