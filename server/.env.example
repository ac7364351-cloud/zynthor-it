# ==============================================================================
# Zynthor Business OS — Backend Environment Configuration Example
# Copy this file to .env and configure for your deployment environment.
# ==============================================================================

PORT=8000
NODE_ENV=production

# JSON Web Token Cryptographic Signing Key (Must be at least 32 characters in production)
JWT_SECRET=your_cryptographically_secure_random_jwt_secret_min_32_characters

# Database Configuration (Option 1: Unified URI - Recommended for Cloud TiDB/Aiven/AWS)
# DATABASE_URL=mysql://username:password@gateway.example.com:4000/zynthor_it

# Database Configuration (Option 2: Discrete Parameters)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_secure_db_password
DB_NAME=zynthor_it

# SSL Configuration for Cloud Managed MySQL (TiDB, PlanetScale, Aiven, RDS)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Optional CORS Origin Restriction (e.g. https://zynthor.example.com)
FRONTEND_URL=http://localhost:5173

# Optional External AI API Key (Gemini or OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
